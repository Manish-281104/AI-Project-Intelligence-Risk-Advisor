# =====================================================================
# AI Project Intelligence & Risk Advisor - Master Environment Config
# =====================================================================

# Backend API Configuration
APP_NAME="AI Project Intelligence & Risk Advisor API"
APP_VERSION="0.2.0 (Milestone 2)"
DEBUG=false
HOST=127.0.0.1
PORT=8000

# Cross-Origin Resource Sharing (CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Ingestion & Chunking Constraints
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=15
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Optional LLM API Configuration (Offline deterministic engine active if omitted)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Frontend Configuration (Used by Vite)
VITE_API_BASE_URL=http://127.0.0.1:8000
