# =====================================================================
# AI Project Intelligence & Risk Advisor - Backend Environment Config
# =====================================================================

# Server & Application Information
APP_NAME="AI Project Intelligence & Risk Advisor API"
APP_VERSION="0.2.0 (Milestone 2)"
DEBUG=false
HOST=127.0.0.1
PORT=8000

# CORS Permitted Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Storage & Ingestion Limits
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=15

# Document Chunking Settings
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Optional LLM API Keys (Leave blank to use deterministic offline grounded multi-agent reasoning)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
