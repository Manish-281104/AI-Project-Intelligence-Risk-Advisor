# =====================================================================
# AI Project Intelligence & Risk Advisor
# Comprehensive .gitignore
# React + TypeScript + Vite + Python + FastAPI
# =====================================================================


# ---------------------------------------------------------------------
# 1. Python & Virtual Environments
# ---------------------------------------------------------------------

__pycache__/
*.py[cod]
*$py.class
*.so
.Python

.venv/
venv/
env/
ENV/

backend/.venv/
backend/venv/
backend/env/

build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg


# ---------------------------------------------------------------------
# 2. Python Testing & Coverage
# ---------------------------------------------------------------------

.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/

.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
pytestdebug.log


# ---------------------------------------------------------------------
# 3. Node.js & Frontend (React + Vite + TypeScript)
# ---------------------------------------------------------------------

node_modules/
frontend/node_modules/

dist/
frontend/dist/

.vite/
frontend/.vite/

coverage/
frontend/coverage/

.eslintcache
*.tsbuildinfo

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# ---------------------------------------------------------------------
# 4. Environment Variables & Secrets (CRITICAL SECURITY)
# ---------------------------------------------------------------------

.env
.env.*
!.env.example

*.pem
*.key
*.cert
*.crt

credentials.json
service-account.json
client_secret*.json

# Ignore LICENSE as explicitly requested
LICENSE


# ---------------------------------------------------------------------
# 5. IDE, Editors & Operating System
# ---------------------------------------------------------------------

.vscode/
.idea/
*.swp
*.swo
*~

.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini


# ---------------------------------------------------------------------
# 6. Logs & Temporary Files
# ---------------------------------------------------------------------

*.log
logs/
tmp/
temp/
cache/
.cache/

*.tmp
*.bak
*.old
*.orig


# ---------------------------------------------------------------------
# 7. Local Uploaded Documents & Runtime Storage
# ---------------------------------------------------------------------

backend/uploads/*
!backend/uploads/.gitkeep

uploads/*
!uploads/.gitkeep

backend/data/*
!backend/data/.gitkeep

data/*
!data/.gitkeep


# ---------------------------------------------------------------------
# 8. Vector Databases & Local Database Files
# ---------------------------------------------------------------------

chroma_db/
.chromadb/
vector_db/
vector_store/
faiss_index/

*.chroma
*.sqlite
*.sqlite3
*.db
*.db-journal


# ---------------------------------------------------------------------
# 9. Model Files & Generated AI Artifacts
# ---------------------------------------------------------------------

*.pt
*.pth
*.onnx
*.h5
*.keras
*.pkl
*.joblib
*.safetensors

# Ignore generated model cache directories
model_cache/
models/cache/


# ---------------------------------------------------------------------
# 10. Generated Reports & Temporary Exports
# ---------------------------------------------------------------------

*.log
*.temp
*.swp

# Temporary generated exports
exports/
generated_temp/


# ---------------------------------------------------------------------
# 11. Milestone Documentation Folders
# These folders must NOT be uploaded to GitHub.
# They remain available locally.
# ---------------------------------------------------------------------

milestone1_deliverables/
milestone2_deliverables/
Milestone2_Updated_Documents/


# ---------------------------------------------------------------------
# 12. Keep Required Source and Configuration Files
# ---------------------------------------------------------------------

# Keep environment example files
!.env.example

# Keep dependency manifests
!requirements.txt
!package.json
!package-lock.json

# Keep sample documents
!sample_documents/
!sample_documents/**